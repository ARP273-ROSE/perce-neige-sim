## Axe de la piste i en points (x, z).
static func axe(i: int) -> PackedVector2Array:
	var f: Array = PISTES[i][2]
	var out: PackedVector2Array = PackedVector2Array()
	for k in range(0, f.size() - 1, 2):
		out.append(Vector2(f[k], f[k + 1]))
	return out
