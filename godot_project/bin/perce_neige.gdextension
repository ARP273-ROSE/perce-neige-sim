[configuration]

entry_symbol = "perce_neige_init"
compatibility_minimum = "4.5"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://bin/libperce_neige.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libperce_neige.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/libperce_neige.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/libperce_neige.linux.template_release.arm64.so"
windows.debug.x86_64 = "res://bin/libperce_neige.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libperce_neige.windows.template_release.x86_64.dll"
macos.debug = "res://bin/libperce_neige.macos.template_debug.universal.dylib"
macos.release = "res://bin/libperce_neige.macos.template_release.universal.dylib"
